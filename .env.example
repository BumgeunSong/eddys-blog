# Keystatic storage mode.
#   unset / anything but "github" -> LOCAL mode (writes content/*.mdx directly).
#     Fine for `next dev` authoring; the default. Do NOT use on Vercel (its
#     filesystem is read-only, so edits can't persist).
#   "github" -> GITHUB mode. Required in production (Vercel). Also set this
#     locally when running the one-time "Create GitHub App" flow at
#     /keystatic/setup.
NEXT_PUBLIC_KEYSTATIC_STORAGE=

# GitHub App credentials (GITHUB mode only). You get all four from the
# "Create GitHub App" walkthrough at /keystatic/setup — run it once locally with
# NEXT_PUBLIC_KEYSTATIC_STORAGE=github, then copy the printed values here and
# into your Vercel project settings. See https://keystatic.com/docs/github-mode
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
